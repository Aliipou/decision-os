{
  "v": 1,
  "area": "install",
  "name": "json-symlinked-file",
  "input": {
    "kind": "run",
    "client": "claude-desktop",
    "project": false,
    "path": ".config/Claude/claude_desktop_config.json",
    "binary": "/opt/decision-os/bin/decision-os",
    "before": {
      "text": "{\n  \"mcpServers\": {\n    \"a\": {\n      \"command\": \"npx\",\n      \"args\": [\n        \"-y\",\n        \"a\"\n      ]\n    }\n  }\n}"
    },
    "steps": [
      {
        "action": "install",
        "dry_run": false,
        "force_jsonc": false
      },
      {
        "action": "uninstall",
        "dry_run": false,
        "force_jsonc": false
      }
    ],
    "symlink_to": "dotfiles/claude.json"
  },
  "expected": {
    "ok": {
      "steps": [
        {
          "report": {
            "status": "ok",
            "wrapped": [
              "a"
            ],
            "already": [],
            "plain": [],
            "remote": [],
            "unwrapped": [],
            "message": null
          },
          "file": {
            "text": "{\n  \"mcpServers\": {\n    \"a\": {\n      \"command\": \"/opt/decision-os/bin/decision-os\",\n      \"args\": [\n        \"mcp-proxy\",\n        \"--home\",\n        \"@DOS_HOME@\",\n        \"--client\",\n        \"claude-desktop\",\n        \"--server\",\n        \"a\",\n        \"--\",\n        \"npx\",\n        \"-y\",\n        \"a\"\n      ]\n    }\n  }\n}"
          },
          "symlink": true
        },
        {
          "report": {
            "status": "ok",
            "wrapped": [],
            "already": [],
            "plain": [],
            "remote": [],
            "unwrapped": [
              "a"
            ],
            "message": "restored-exact"
          },
          "file": {
            "text": "{\n  \"mcpServers\": {\n    \"a\": {\n      \"command\": \"npx\",\n      \"args\": [\n        \"-y\",\n        \"a\"\n      ]\n    }\n  }\n}"
          },
          "symlink": true
        }
      ]
    }
  },
  "oracle_expected": {
    "ok": {
      "steps": [
        {
          "report": {
            "status": "ok",
            "wrapped": [
              "a"
            ],
            "already": [],
            "plain": [],
            "remote": [],
            "unwrapped": [],
            "message": null
          },
          "file": {
            "text": "{\n  \"mcpServers\": {\n    \"a\": {\n      \"command\": \"/opt/decision-os/bin/decision-os\",\n      \"args\": [\n        \"mcp-proxy\",\n        \"--home\",\n        \"@DOS_HOME@\",\n        \"--client\",\n        \"claude-desktop\",\n        \"--server\",\n        \"a\",\n        \"--\",\n        \"npx\",\n        \"-y\",\n        \"a\"\n      ]\n    }\n  }\n}"
          },
          "symlink": false
        },
        {
          "report": {
            "status": "ok",
            "wrapped": [],
            "already": [],
            "plain": [],
            "remote": [],
            "unwrapped": [
              "a"
            ],
            "message": "restored-exact"
          },
          "file": {
            "text": "{\n  \"mcpServers\": {\n    \"a\": {\n      \"command\": \"npx\",\n      \"args\": [\n        \"-y\",\n        \"a\"\n      ]\n    }\n  }\n}"
          },
          "symlink": false
        }
      ]
    }
  },
  "divergence": "the oracle's rename replaces the symlink with a regular file, so the link is lost; Rust writes the link target and keeps the link",
  "source": "REDTEAM installer: symlinked files"
}
