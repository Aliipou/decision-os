{
  "v": 1,
  "area": "install",
  "name": "registry-linux-no-xdg",
  "input": {
    "kind": "registry",
    "os": "linux",
    "env": {
      "HOME": "<root>/u",
      "USERPROFILE": "<root>/u",
      "XDG_CONFIG_HOME": ""
    },
    "files": []
